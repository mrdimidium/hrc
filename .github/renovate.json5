{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Include commit-to-commit comparisons when updating GitHub SHA pins.
  extends: ["helpers:githubDigestChangelogs"],
  timezone: "Etc/UTC",

  automerge: false,
  dependencyDashboard: true,
  pinDigests: true,

  // Allow time for upstream problems to surface before proposing updates.
  minimumReleaseAge: "7 days",
  prConcurrentLimit: 10,

  // Mise lockfile updates use safe mode rather than unsafe execution.
  constraints: { mise: ">=2026.7.12" },

  enabledManagers: ["github-actions", "mise", "bazel-module", "custom.regex"],
  separateMajorMinor: true,

  customManagers: [
    {
      customType: "regex",
      description: "Update annotated toolchain versions in Bazel modules",
      depTypeTemplate: "bazel-toolchain",
      managerFilePatterns: ["/(^|/)MODULE\\.bazel$/"],
      // The version must be the first double-quoted string on the next line.
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)[ \\t]*\\r?\\n[^"\\r\\n]*"(?<currentValue>[^"\\r\\n]+)"',
      ],
    },
  ],
  packageRules: [
    {
      // Major updates deliberately remain ungrouped for individual review.
      groupName: "github actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
    },

    {
      groupName: "mise",
      matchManagers: ["mise"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
    },

    {
      groupName: "bazel modules",
      matchManagers: ["bazel-module"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
    },
    {
      groupName: "bazel toolchains",
      matchManagers: ["custom.regex"],
      matchDepTypes: ["bazel-toolchain"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
    },
    {
      matchManagers: ["bazel-module"],
      // BCR releases may lack timestamps; do not hold those updates indefinitely.
      // Releases with a known timestamp still observe minimumReleaseAge.
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      matchManagers: ["bazel-module", "custom.regex"],
      // Other regex managers must not trigger Bazel lockfile generation.
      // JSONata sees the internal name "regex", not the matchManagers alias.
      matchJsonata: ['manager = "bazel-module" or (manager = "regex" and depType = "bazel-toolchain")'],
      // Use our mise-pinned Bazel for both module and toolchain lockfile updates.
      skipArtifactsUpdate: true,
      postUpgradeTasks: {
        commands: [".github/renovate-cmd bazel-lock"],
        installTools: { mise: {} },
        executionMode: "branch",
        fileFilters: ["MODULE.bazel.lock"],
      },
    },
  ],
}
