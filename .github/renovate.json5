// SPDX-License-Identifier: BSD-3-Clause

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Include commit-to-commit comparisons when updating GitHub SHA pins.
  extends: ["helpers:githubDigestChangelogs"],
  timezone: "Etc/UTC",

  automerge: false,
  dependencyDashboard: true,
  pinDigests: true,

  // Allow time for upstream problems to surface before proposing updates.
  minimumReleaseAge: "7 days",
  prConcurrentLimit: 10,

  enabledManagers: [
    "gomod", "pip_requirements",
    "github-actions", "bazelisk", "bazel-module", "custom.regex",
  ],
  separateMajorMinor: true,

  // Only edit the input; Bazel regenerates the hashed transitive lockfile.
  pip_requirements: { managerFilePatterns: ["/^tools/requirements\\.in$/"] },

  customManagers: [
    {
      customType: "regex",
      description: "Prepare upstream Worker updates for manual compatibility review",
      depTypeTemplate: "runner-source",
      datasourceTemplate: "github-releases",
      depNameTemplate: "actions/runner",
      versioningTemplate: "semver",
      extractVersionTemplate: "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      managerFilePatterns: ["/^MODULE\\.bazel$/"],
      matchStrings: ['RUNNER_VERSION = "(?<currentValue>\\d+\\.\\d+\\.\\d+)"'],
    },
    {
      customType: "regex",
      description: "Update Worker Node runtimes within their manually selected majors",
      depTypeTemplate: "node-runtime",
      datasourceTemplate: "node-version",
      depNameTemplate: "node{{{runtimeMajor}}}",
      packageNameTemplate: "node",
      versioningTemplate: "node",
      managerFilePatterns: ["/^MODULE\\.bazel$/"],
      matchStrings: [
        '"(?<runtimeMajor>\\d+)": \\("(?<currentValue>\\d+\\.\\d+\\.\\d+)", "[a-f0-9]{64}", "[a-f0-9]{64}"\\)',
      ],
    },
    {
      customType: "regex",
      description: "Update annotated toolchain versions in Bazel modules",
      depTypeTemplate: "bazel-toolchain",
      managerFilePatterns: ["/(^|/)MODULE\\.bazel$/"],
      // The version must be the first double-quoted string on the next line.
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)[ \\t]*\\r?\\n[^"\\r\\n]*"(?<currentValue>[^"\\r\\n]+)"',
      ],
    },
    {
      customType: "regex",
      description: "Update .NET SDKs supported by the pinned rules_dotnet release",
      depTypeTemplate: "bazel-toolchain",
      datasourceTemplate: "custom.rules-dotnet-sdk",
      depNameTemplate: "dotnet-sdk",
      versioningTemplate: "semver",
      registryUrlTemplate: "https://raw.githubusercontent.com/bazel-contrib/rules_dotnet/v{{{rulesVersion}}}/dotnet/private/sdk/versions.bzl",
      managerFilePatterns: ["/(^|/)MODULE\\.bazel$/"],
      matchStringsStrategy: "recursive",
      // Carry the BCR module version into the SDK's registry URL, but replace
      // only the inner SDK declaration. New ruleset support follows its merge.
      matchStrings: [
        'bazel_dep\\(name = "rules_dotnet", version = "(?<rulesVersion>[^"\\r\\n]+)"\\)[\\s\\S]*',
        'dotnet\\.toolchain\\(dotnet_version = "(?<currentValue>[^"\\r\\n]+)"\\)',
      ],
    },
  ],
  customDatasources: {
    "rules-dotnet-sdk": {
      format: "plain",
      transformTemplates: [
        // Plain datasource input is one release.version per trimmed text line.
        '$match($join(releases.version, "\\n"), /"(\\d+\\.\\d+\\.\\d+)": \\{([\\s\\S]*?)\\n\\},/)',
        // Keep only version blocks containing all six project platforms.
        '($platforms := ["aarch64-apple-darwin", "x86_64-apple-darwin", "arm64-pc-windows-msvc", "x86_64-pc-windows-msvc", "arm64-unknown-linux-gnu", "x86_64-unknown-linux-gnu"]; $filter($, function($block) { $count($filter($platforms, function($platform) { $contains($block.groups[1], "\\\"" & $platform & "\\\": {") })) = $count($platforms) }))',
        // Major SDK migrations remain deliberate, independent of the ruleset.
        '{"releases": [$[$split(groups[0], ".")[0] = $split("{{{currentValue}}}", ".")[0]].{"version": groups[0]}]}',
      ],
    },
  },
  packageRules: [
    {
      groupName: "go modules",
      matchManagers: ["gomod"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
    },
    {
      matchManagers: ["gomod"],
      constraintsFiltering: "strict",
    },
    {
      matchManagers: ["gomod"],
      // SDK updates belong to Bazel; indirect modules follow direct updates.
      matchDepTypes: ["golang", "toolchain", "indirect"],
      enabled: false,
    },

    {
      groupName: "python tools",
      matchManagers: ["pip_requirements"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
    },
    {
      // managerFilePatterns adds to defaults; do not edit the generated lock.
      matchManagers: ["pip_requirements"],
      matchFileNames: ["!tools/requirements.in"],
      enabled: false,
    },
    {
      matchManagers: ["pip_requirements"],
      matchFileNames: ["tools/requirements.in"],
      skipArtifactsUpdate: true,
      postUpgradeTasks: {
        commands: [".github/renovate-cmd python-lock", ".github/renovate-cmd bazel-lock"],
        installTools: { bazelisk: {} },
        executionMode: "branch",
        fileFilters: ["tools/requirements.txt", "MODULE.bazel.lock"],
      },
    },

    {
      // Major updates deliberately remain ungrouped for individual review.
      groupName: "github actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
    },

    {
      groupName: "bazel",
      matchManagers: ["bazelisk"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
    },

    {
      groupName: "bazel modules",
      matchManagers: ["bazel-module"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
    },
    {
      groupName: "bazel toolchains",
      matchManagers: ["custom.regex"],
      matchDepTypes: ["bazel-toolchain"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
    },
    {
      matchManagers: ["bazel-module"],
      // BCR releases may lack timestamps; do not hold those updates indefinitely.
      // Releases with a known timestamp still observe minimumReleaseAge.
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      matchDatasources: ["custom.rules-dotnet-sdk"],
      // The support table has no release dates; do not block SDKs indefinitely.
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      matchManagers: ["bazelisk", "bazel-module", "custom.regex"],
      // Other regex managers must not trigger Bazel lockfile generation.
      // JSONata sees the internal name "regex", not the matchManagers alias.
      matchJsonata: ['manager = "bazelisk" or manager = "bazel-module" or (manager = "regex" and depType = "bazel-toolchain")'],
      // Bazelisk reads the single Bazel pin from .bazelversion.
      skipArtifactsUpdate: true,
      postUpgradeTasks: {
        commands: [".github/renovate-cmd bazel-lock"],
        installTools: { bazelisk: {} },
        executionMode: "branch",
        fileFilters: ["MODULE.bazel.lock"],
      },
    },

    {
      // The trusted workflow supplies a preflight allowlist before extraction.
      // Without it (including other Renovate deployments), do not propose Node updates.
      matchManagers: ["custom.regex"],
      matchDepTypes: ["node-runtime"],
      matchJsonata: ["$not($exists(allowedVersions))"],
      enabled: false,
    },
    {
      // Runtime majors follow actions/runner and are changed only by hand.
      matchManagers: ["custom.regex"],
      matchDepTypes: ["node-runtime"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      matchManagers: ["custom.regex"],
      matchDepTypes: ["node-runtime"],
      skipArtifactsUpdate: true,
      postUpgradeTasks: {
        commands: [".github/renovate-cmd node-lock"],
        installTools: { bazelisk: {} },
        executionMode: "branch",
        fileFilters: ["MODULE.bazel", "MODULE.bazel.lock"],
      },
    },

    {
      matchManagers: ["custom.regex"],
      matchDepTypes: ["runner-source"],
      draftPR: true,
      automerge: false,
      // Prepare the draft immediately; compatibility is reviewed by hand.
      minimumReleaseAge: "0 days",
      prBodyNotes: [
        "Manual review required: compare upstream changes with `internal/listener`, verify the semantics of `internal/worker/patch/`, and check Node runtime requirements before marking this draft ready.",
      ],
      skipArtifactsUpdate: true,
      postUpgradeTasks: {
        commands: [".github/renovate-cmd runner-lock"],
        installTools: { bazelisk: {} },
        executionMode: "branch",
        fileFilters: ["MODULE.bazel", "MODULE.bazel.lock"],
      },
    },
  ],
}
