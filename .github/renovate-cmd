set -euo pipefail

if [[ $# -ne 1 ]]; then
    printf 'Usage: %s <command>\n' "$0" >&2
    exit 2
fi

case "$1" in
    python-lock)
        cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
        exec bazel run //tools:requirements.update
        ;;
    bazel-lock)
        cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
        exec bazel mod deps --lockfile_mode=update
        ;;
    *)
        printf 'Unknown command: %s\n' "$1" >&2
        exit 2
        ;;
esac
