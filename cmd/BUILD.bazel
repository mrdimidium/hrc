load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools:platforms.bzl", "PLATFORMS")

exports_files(["BUILD.bazel"])

go_library(
    name = "cmd_lib",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "gilti.dev/hrc/cmd",
    visibility = ["//:__pkg__"],  # keep
    deps = ["@com_github_actions_scaleset//:scaleset"],
)

[go_binary(
    name = arch + "_" + os,
    embed = [":cmd_lib"],
    gc_linkopts = [
        "-s",
        "-w",
    ],
    goarch = arch,
    goos = os,
    pure = "on",
    tags = ["manual"],
    visibility = ["//visibility:public"],
) for arch, os in PLATFORMS]

alias(
    name = "hrc",
    actual = select({
        "//:host_" + arch + "_" + os: ":" + arch + "_" + os
        for arch, os in PLATFORMS
    }),
    visibility = ["//visibility:public"],
)

go_test(
    name = "cmd_test",
    size = "small",
    srcs = glob(["*_test.go"]),  # keep
    embed = [":cmd_lib"],
)
