load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools:platforms.bzl", "ARCH", "OS")
load("//tools/rules_service:service.bzl", "service")

exports_files(["BUILD.bazel"])

go_library(
    name = "cmd_lib",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "gilti.dev/hrc/cmd",
    visibility = ["//:__pkg__"],  # keep
    deps = [
        "//pkg/listener",
        "//pkg/worker",
        "@com_github_actions_scaleset//:scaleset",
    ] + select({
        "@rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

go_binary(
    name = "hrc",
    embed = [":cmd_lib"],
    gc_linkopts = [
        "-s",
        "-w",
    ],
    pure = "on",
    visibility = ["//visibility:public"],
    x_defs = {"gilti.dev/hrc/cmd.Version": "{STABLE_HRC_VERSION}"},
)

go_test(
    name = "cmd_test",
    size = "small",
    srcs = glob(["*_test.go"]),  # keep
    embed = [":cmd_lib"],
    deps = [
        "//pkg/listener",
        "//pkg/worker",
        "@com_github_actions_scaleset//:scaleset",
    ],
)

service(
    name = "release",
    service = "hrc",
    description = "Hosted Runner Controller",
    deps = [
        "//:docs",
        "//:licenses",
        "//runner",
    ],
    os = OS,
    arch = ARCH,
    bin = ":hrc",
    args = [
        "-config",
        "{config}",
    ],
    config = "pkg/hrc.json",
    installer = select({
        "@platforms//os:windows": "pkg/control.ps1",
        "//conditions:default": "pkg/control",
    }),
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
