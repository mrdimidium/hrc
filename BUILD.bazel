load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@gazelle//:def.bzl", "gazelle")

bool_flag(
    name = "bundled-dotnet",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//cmd:__pkg__"],
)

filegroup(
    name = "licenses",
    srcs = ["LICENSE"] + glob(["LICENSES/*"]),
    visibility = ["//cmd:__pkg__"],
)

# gazelle:prefix gilti.dev/hrc
# gazelle:exclude dist
# gazelle:exclude runner

gazelle(name = "gazelle")

test_suite(
    name = "tests",
    tests = [
        "//cmd:cmd_test",
        "//internal/listener:listener_test",
        "//internal/process:process_test",
        "//internal/worker:worker_test",
        "//runner:runtime_config_test",
    ],
)

filegroup(
    name = "starlark_sources",
    srcs = [
        "BUILD.aspect",
        "BUILD.bazel",
        "MODULE.aspect",
        "MODULE.bazel",
    ] + [
        "//cmd:BUILD.bazel",
        "//internal/listener:BUILD.bazel",
        "//internal/process:BUILD.bazel",
        "//internal/worker:BUILD.bazel",
        "//runner:starlark_sources",
        "//tools:starlark_sources",
        "//tools/format:BUILD.bazel",
        "//tools/rules_msbuild:starlark_sources",
        "//tools/rules_service:starlark_sources",
    ],
    tags = [
        "lint-with-buildifier",
        "manual",
    ],
)

alias(
    name = "runner",
    actual = "//runner",
    tags = ["manual"],
)

alias(
    name = "hrc",
    actual = "//cmd:hrc",
    visibility = ["//visibility:public"],
)
