load("//tools:platforms.bzl", "PLATFORMS")

exports_files(["go.mod", "go.sum"])

alias(
    name = "hrc",
    actual = "//cmd:hrc",
    visibility = ["//visibility:public"],
)

alias(
    name = "runner",
    actual = "//runner",
    tags = ["manual"],
)

[config_setting(
    name = "host_" + arch + "_" + os,
    constraint_values = [
        "@platforms//cpu:" + {
            "amd64": "x86_64",
            "arm64": "aarch64",
        }[arch],
        "@platforms//os:" + ("osx" if os == "darwin" else os),
    ],
    visibility = ["//visibility:public"],
) for arch, os in PLATFORMS]
