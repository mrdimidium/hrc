load("@gazelle//:def.bzl", "gazelle")

filegroup(
    name = "docs",
    srcs = ["README.md"],
    visibility = ["//cmd:__pkg__"],
)

filegroup(
    name = "licenses",
    srcs = ["LICENSE"] + glob(["LICENSES/*"]),
    visibility = ["//cmd:__pkg__"],
)

# gazelle:prefix gilti.dev/hrc
# gazelle:exclude dist
# gazelle:exclude runner

gazelle(name = "gazelle")

filegroup(
    name = "starlark_sources",
    srcs = [
        "BUILD.aspect",
        "BUILD.bazel",
        "MODULE.aspect",
        "MODULE.bazel",
    ] + [
        "//cmd:BUILD.bazel",
        "//runner:starlark_sources",
        "//tools:starlark_sources",
        "//tools/format:BUILD.bazel",
        "//tools/rules_service:starlark_sources",
    ],
    tags = [
        "lint-with-buildifier",
        "manual",
    ],
)

alias(
    name = "runner",
    actual = "//runner",
    tags = ["manual"],
)

alias(
    name = "hrc",
    actual = "//cmd:hrc",
    visibility = ["//visibility:public"],
)
