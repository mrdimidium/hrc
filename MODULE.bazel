module(name = "hrc")

bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "rules_dotnet", version = "0.22.2")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "rules_python", version = "1.7.0")

# Allow compiler options to name generated resources by their Bazel labels.
single_version_override(
    module_name = "rules_dotnet",
    patch_strip = 1,
    patches = ["//runner:patch/rules-dotnet-resources.patch"],
)

bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

# Go
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.2")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_actions_scaleset", "org_golang_x_oauth2", "org_golang_x_sys")

# Python
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.13")
use_repo(python, "python_3_13_host", "pythons_hub")

register_toolchains("@pythons_hub//:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "patch_ng",
    urls = ["https://github.com/conan-io/python-patch-ng/archive/refs/tags/1.19.0.tar.gz"],
    integrity = "sha256-Gb4jkHC5YiT/XZXeW+PAEGEDYc3JKvhjRYj4yYaG7wg=",
    strip_prefix = "python-patch-ng-1.19.0",
    build_file_content = """
load("@rules_python//python:py_library.bzl", "py_library")
py_library(
    name = "patch_ng",
    srcs = ["patch_ng.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)
""",
)

# .NET
dotnet = use_extension("@rules_dotnet//dotnet:extensions.bzl", "dotnet")
dotnet.toolchain(dotnet_version = "10.0.400")
use_repo(dotnet, "dotnet_toolchains")
use_repo(
    dotnet,
    "dotnet_aarch64-apple-darwin",
    "dotnet_arm64-pc-windows-msvc",
    "dotnet_arm64-unknown-linux-gnu",
    "dotnet_x86_64-apple-darwin",
    "dotnet_x86_64-pc-windows-msvc",
    "dotnet_x86_64-unknown-linux-gnu",
)

register_toolchains("@dotnet_toolchains//:all")

# Github Actions runner
runner_restore = use_extension("//runner:nuget.bzl", "restore")
use_repo(runner_restore, "worker_restore")

runner_deps = use_extension("//runner:nuget.bzl", "dependencies")
use_repo(runner_deps, "worker_nuget")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")

# Versions follow upstream; musl builds come from actions/alpine_nodejs (x64)
# and unofficial-builds.nodejs.org (arm64).
NODE = {
    "20": ("20.20.2", "f21a2253025a5d1a14332a0b1ed48871689c5ca9aa37a6141428944b75de7d91", "7549872a8d1be4670d5219f39dc0aed6e6432c976f3cd25543bc249aa850f041"),
    "24": ("24.21.0", "2a4a9c6af9b6f1dd67e4c460474a6fbb64fafffe49e1166af80715bfd4e50775", "3048b0811e158ca0d8672b59c839861763e144492980d8d29b369dfee45747e4"),
}

[
    node.toolchain(
        name = "node" + major,
        node_version = version,
    )
    for major, (version, _, _) in NODE.items()
]

[
    node.toolchain(
        name = "node" + major + "_musl",
        node_version = version,
        node_urls = ["{filename}"],
        node_repositories = {
            version + "-linux_amd64": [
                "https://github.com/actions/alpine_nodejs/releases/download/v%s/node-v%s-alpine-x64.tar.gz" % (version, version),
                "",
                x64_hash,
            ],
            version + "-linux_arm64": [
                "https://unofficial-builds.nodejs.org/download/release/v%s/node-v%s-linux-arm64-musl.tar.gz" % (version, version),
                "node-v%s-linux-arm64-musl" % version,
                arm64_hash,
            ],
        },
    )
    for major, (version, x64_hash, arm64_hash) in NODE.items()
]

[
    use_repo(
        node,
        **{
            version + "_win_" + arch: version + "_windows_" + ("amd64" if arch == "x64" else arch),
            version + "_darwin_" + arch: version + "_darwin_" + ("amd64" if arch == "x64" else arch),
            version + "_linux_glibc_" + arch: version + "_linux_" + ("amd64" if arch == "x64" else arch),
            version + "_linux_musl_" + arch: version + "_musl_linux_" + ("amd64" if arch == "x64" else arch),
        }
    )
    for version in [
        "node20",
        "node24",
    ]
    for arch in [
        "x64",
        "arm64",
    ]
]
