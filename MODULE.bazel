module(name = "hrc")

bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "rules_dotnet", version = "0.22.2")
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "rules_python", version = "2.5.1")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# Go
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

# renovate: datasource=golang-version depName=go
go_sdk.download(version = "1.27.3")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_actions_scaleset", "org_golang_x_oauth2", "org_golang_x_sys")

# Python
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.13")
use_repo(python, "python_3_13_host", "pythons_hub")

register_toolchains("@pythons_hub//:all")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "python_tools",
    python_version = "3.13",
    requirements_lock = "//tools:requirements.txt",
    target_platforms = [
        "linux_x86_64",
        "linux_aarch64",
        "osx_x86_64",
        "osx_aarch64",
        "windows_x86_64",
        "windows_aarch64",
    ],
    download_only = True,
    experimental_index_url = "https://pypi.org/simple",
)
use_repo(pip, "python_tools")

pip.parse(
    hub_name = "ansible_deps",
    python_version = "3.13",
    requirements_lock = "//tools/rules_ansible:requirements.txt",
)
use_repo(pip, "ansible_deps")

# .NET
dotnet = use_extension("@rules_dotnet//dotnet:extensions.bzl", "dotnet")

# Renovate selects SDKs from the pinned rules_dotnet release's support table.
dotnet.toolchain(dotnet_version = "10.0.400")
use_repo(dotnet, "dotnet_toolchains")
use_repo(
    dotnet,
    "dotnet_aarch64-apple-darwin",
    "dotnet_arm64-pc-windows-msvc",
    "dotnet_arm64-unknown-linux-gnu",
    "dotnet_x86_64-apple-darwin",
    "dotnet_x86_64-pc-windows-msvc",
    "dotnet_x86_64-unknown-linux-gnu",
)

register_toolchains("@dotnet_toolchains//:all")

# Github Actions runner
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Native esbuild CLI: no npm installation or system Node.js required.
# renovate: datasource=npm depName=esbuild
ESBUILD_VERSION = "0.25.12"

ESBUILD_PLATFORMS = {
    "darwin_arm64": "2e0d011f852e45046ca5c107db54cfc56338f77aca49d227a063696d958451d7",
    "darwin_x64": "bf56cdf7b330a8605395ee13de805c784c7346d0802c7cced8490b4bfac2291a",
    "linux_arm64": "d5e01d210e026823d559e2b82554cdcdab6fd87c4a57b519b392ef183c1f87fd",
    "linux_x64": "f7efc127658a108dcda9d4210b01804ee8f5d6b3acbd6d63f20aa51d3b50bd5f",
    "win32_arm64": "01979ffafb4bb6a63d824cd57ed76bd257d1e3eed804c3e47fdfd80005dcfa66",
    "win32_x64": "c77076b48f96323cae6257bd515e5ea96ecf38ab8f7fa34364d4fc4ae5905b74",
}

[
    http_archive(
        name = "esbuild_" + platform,
        urls = ["https://registry.npmjs.org/@esbuild/%s/-/%s-%s.tgz" % (
            platform.replace("_", "-"),
            platform.replace("_", "-"),
            ESBUILD_VERSION,
        )],
        sha256 = checksum,
        strip_prefix = "package",
        build_file_content = 'exports_files(["%s"])' % ("esbuild.exe" if platform.startswith("win32") else "bin/esbuild"),
    )
    for platform, checksum in ESBUILD_PLATFORMS.items()
]

# Private Windows service wrapper, embedded in the Ansible collection.
http_file(
    name = "ansible_winsw",
    urls = ["https://github.com/winsw/winsw/releases/download/v2.12.0/WinSW-x64.exe"],
    sha256 = "05b82d46ad331cc16bdc00de5c6332c1ef818df8ceefcd49c726553209b3a0da",
    downloaded_file_path = "winsw.exe",
)

http_file(
    name = "ansible_winsw_license",
    urls = ["https://raw.githubusercontent.com/winsw/winsw/v2.12.0/LICENSE.txt"],
    sha256 = "1cdf703c10a70e5973bf3acf2a5eeabe7746237155b92db2034aeae26fdf7802",
    downloaded_file_path = "WinSW-LICENSE.txt",
)

http_file(
    name = "ansible_windows_test",
    urls = ["https://galaxy.ansible.com/api/v3/plugin/ansible/content/published/collections/artifacts/ansible-windows-3.3.0.tar.gz"],
    sha256 = "1d5793991e342dcbbcd8377e62e3f8443d39c3e625272118dae895ed43f5539c",
    downloaded_file_path = "ansible-windows-3.3.0.tar.gz",
)

RUNNER_VERSION = "2.338.2"

http_file(
    name = "actions_runner_license",
    urls = ["https://raw.githubusercontent.com/actions/runner/v%s/LICENSE" % RUNNER_VERSION],
    sha256 = "621a1e0b6163b9d63fe780b9d6f5a7f775a5781065024a1ebf8010726c44cec1",
    downloaded_file_path = "LICENSE",
)

http_archive(
    name = "actions_runner",
    urls = ["https://github.com/actions/runner/archive/refs/tags/v%s.tar.gz" % RUNNER_VERSION],
    sha256 = "3b7549b6cd109cd534de3e904cb257cd8447c1d00dd96d2242b7747b3473ce1f",
    strip_prefix = "runner-%s/src" % RUNNER_VERSION,
    build_file_content = 'load("@hrc//internal/worker:runner.bzl", "runner_sources")\nrunner_sources(version = "%s")\n' % RUNNER_VERSION,
    patches = [
        "//internal/worker:patch/runtime-config.patch",
        "//internal/worker:patch/diagnostics.patch",
        "//internal/worker:patch/single-file.patch",
        "//internal/worker:patch/resources-layout.patch",
    ],
    patch_args = ["-p2"],
)

msbuild_deps = use_extension("//tools/rules_msbuild:dependencies.bzl", "dependencies")
msbuild_deps.feed(
    name = "msbuild_feed",
    project = "Runner.Worker/Runner.Worker.csproj",
    rids = [
        "linux-x64",
        "linux-arm64",
        "osx-x64",
        "osx-arm64",
        "win-x64",
        "win-arm64",
    ],
    srcs = ["@actions_runner//:" + path for path in [
        "Directory.Build.props",
        "NuGet.Config",
    ] + [project + "/" + project + ".csproj" for project in [
        "Sdk",
        "Runner.Sdk",
        "Runner.Common",
        "Runner.Worker",
    ]]],
    properties = {
        "NuGetAudit": "false",
        "PublishSingleFile": "true",
        "RuntimeIdentifiers": "",
        "SelfContained": "true",
        "TreatWarningsAsErrors": "false",
    },
)
use_repo(msbuild_deps, "msbuild_feed")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")

# Majors follow actions/runner manually; Renovate updates within each major.
# musl builds come from actions/alpine_nodejs (x64) and unofficial-builds.nodejs.org (arm64).
NODE = {
    "20": ("20.20.2", "f21a2253025a5d1a14332a0b1ed48871689c5ca9aa37a6141428944b75de7d91", "7549872a8d1be4670d5219f39dc0aed6e6432c976f3cd25543bc249aa850f041"),
    "24": ("24.22.1", "8fcd43dd6fd73cd450fc6a077d0d62d816cadcf28d85cca51ff85c65587ca707", "8254125825a3e5e834bd8a260dab4c8303f720464a741506ec27989b9ba1769b"),
}

[
    node.toolchain(
        name = "node" + major,
        node_version = version,
    )
    for major, (version, _, _) in NODE.items()
]

[
    node.toolchain(
        name = "node" + major + "_musl",
        node_version = version,
        node_urls = ["{filename}"],
        node_repositories = {
            version + "-linux_amd64": [
                "https://github.com/actions/alpine_nodejs/releases/download/v%s/node-v%s-alpine-x64.tar.gz" % (version, version),
                "",
                x64_hash,
            ],
            version + "-linux_arm64": [
                "https://unofficial-builds.nodejs.org/download/release/v%s/node-v%s-linux-arm64-musl.tar.gz" % (version, version),
                "node-v%s-linux-arm64-musl" % version,
                arm64_hash,
            ],
        },
    )
    for major, (version, x64_hash, arm64_hash) in NODE.items()
]

[
    use_repo(
        node,
        **{
            version + "_win_" + arch: version + "_windows_" + ("amd64" if arch == "x64" else arch),
            version + "_darwin_" + arch: version + "_darwin_" + ("amd64" if arch == "x64" else arch),
            version + "_linux_glibc_" + arch: version + "_linux_" + ("amd64" if arch == "x64" else arch),
            version + "_linux_musl_" + arch: version + "_musl_linux_" + ("amd64" if arch == "x64" else arch),
        }
    )
    for version in [
        "node20",
        "node24",
    ]
    for arch in [
        "x64",
        "arm64",
    ]
]
