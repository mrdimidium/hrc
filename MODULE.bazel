module(name = "hrc")

bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

actions_runner = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

actions_runner(
    name = "actions_runner",
    build_file = "//runner:runner.BUILD.bazel",
    path = "runner/runner",
)

node = use_extension("//runner:runner.bzl", "node_repositories")

[
    use_repo(
        node,
        version + "_win_" + arch,
        version + "_darwin_" + arch,
        version + "_linux_musl_" + arch,
        version + "_linux_glibc_" + arch,
    )
    for version in [
        "node20",
        "node24",
    ]
    for arch in [
        "x64",
        "arm64",
    ]
]

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.2")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_actions_scaleset", "org_golang_x_oauth2", "org_golang_x_sys")
