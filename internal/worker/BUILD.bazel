load("@rules_go//go:def.bzl", "go_library", "go_test")

exports_files(["BUILD.bazel"])

go_library(
    name = "worker",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "gilti.dev/hrc/internal/worker",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/process",
        "//internal/runtime",
    ],
)

go_test(
    name = "worker_test",
    size = "small",
    srcs = glob(["*_test.go"]),
    embed = [":worker"],
    deps = ["//internal/process"],
)
