load("@rules_go//go:def.bzl", "go_library", "go_test")

exports_files(["BUILD.bazel"])

go_library(
    name = "listener",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "dimidiumlabs.io/hrc/internal/provider-github/listener",
    visibility = ["//internal/provider-github:__subpackages__"],  # keep
    deps = [
        "@org_golang_x_oauth2//:oauth2",
        "@org_golang_x_oauth2//clientcredentials",
    ],
)

go_test(
    name = "listener_test",
    size = "small",
    srcs = glob(["*_test.go"]),
    embed = [":listener"],
)
