load("@rules_go//go:def.bzl", "go_library", "go_test")

exports_files(["BUILD.bazel"])

go_library(
    name = "slot-pgroup",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "dimidiumlabs.io/hrc/internal/slot-pgroup",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/runtime",
        "//internal/slot",
    ] + select({
        "@platforms//os:windows": ["@org_golang_x_sys//windows"],
        "//conditions:default": [],
    }),
)

go_test(
    name = "slot-pgroup_test",
    size = "small",
    srcs = glob(["*_test.go"]),
    embed = [":slot-pgroup"],
    deps = [
        "//internal/runtime",
        "//internal/slot",
    ],
)
