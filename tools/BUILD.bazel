load(":tools.bzl", "buildifier_tool")

buildifier_tool(
    name = "buildifier",
    visibility = ["//visibility:public"],
)

buildifier_tool(
    name = "buildifier_lint",
    lint_only = True,
    visibility = ["//visibility:public"],
)

BZLS = ["BUILD.bazel"] + glob(["*.bzl"])

filegroup(
    name = "starlark_sources",
    srcs = BZLS,
    visibility = ["//visibility:public"],
)

exports_files(glob(["*.py"]) + BZLS)

platform(
    name = "linux_amd64",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_arm64",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "darwin_amd64",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "darwin_arm64",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "windows_amd64",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "windows_arm64",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:aarch64",
    ],
)
