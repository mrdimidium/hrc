load("@rules_python//python:pip.bzl", "compile_pip_requirements")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load(":tools.bzl", "buildifier_tool")

buildifier_tool(
    name = "buildifier",
    visibility = ["//visibility:public"],
)

buildifier_tool(
    name = "buildifier_lint",
    lint_only = True,
    visibility = ["//visibility:public"],
)

compile_pip_requirements(
    name = "requirements",
    srcs = ["requirements.in"],
    tags = ["manual"],
    extra_args = [
        "--index-url=https://pypi.org/simple",
        "--no-emit-index-url",
        "--no-emit-trusted-host",
        "--no-strip-extras",
        # Dependency-origin comments vary by host OS (e.g. Sphinx -> colorama).
        "--no-annotate",
    ],
)

py_console_script_binary(
    name = "reuse",
    pkg = "@python_tools//reuse",
    env = {"REUSE_ENCODING_MODULE": "charset_normalizer"},
    visibility = ["//visibility:public"],
)

py_console_script_binary(
    name = "sphinx",
    pkg = "@python_tools//sphinx",
    script = "sphinx-build",
    visibility = ["//:__pkg__"],
)

py_binary(
    name = "site_dev",
    srcs = ["site/dev.py"],
    main = "site/dev.py",
    deps = [
        "@python_tools//sphinx_autobuild",
    ],
    visibility = ["//:__pkg__"],
)

exports_files(["site/conf.py"])

filegroup(
    name = "site_theme",
    srcs = glob(["site/theme/**"]),
    visibility = ["//:__pkg__"],
)

py_test(
    name = "site_test",
    srcs = ["site/site_test.py"],
    main = "site/site_test.py",
    data = ["//:docs"],
    deps = ["@rules_python//python/runfiles"],
)

py_binary(
    name = "publish",
    srcs = ["publish.py"],
    deps = [
        "@python_tools//boto3",
        "@python_tools//botocore",
    ],
)

BZLS = ["BUILD.bazel"] + glob(["*.bzl"])

filegroup(
    name = "starlark_sources",
    srcs = BZLS,
    visibility = ["//visibility:public"],
)

exports_files(["requirements.txt"] + BZLS)

platform(
    name = "linux_amd64",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_arm64",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "darwin_amd64",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "darwin_arm64",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "windows_amd64",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "windows_arm64",
    visibility = ["//visibility:public"],
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:aarch64",
    ],
)
