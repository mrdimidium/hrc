load("@bazel_skylib//rules:select_file.bzl", "select_file")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "strip_prefix")
load("@rules_python//python:py_test.bzl", "py_test")
load("//tools/rules_msbuild:msbuild.bzl", "msbuild_publish")

exports_files(["runner.bzl"] + glob(["patch/*.patch"]))

filegroup(
    name = "starlark_sources",
    srcs = [
        "BUILD.bazel",
        "runner.bzl",
    ],
    visibility = ["//visibility:public"],
)

NODE_PLATFORMS = {
    os + "_" + arch: (os, arch)
    for os in [
        "linux",
        "darwin",
        "win",
    ]
    for arch in [
        "x64",
        "arm64",
    ]
}

[
    config_setting(
        name = "externals_files_" + platform,
        constraint_values = [
            "@platforms//os:" + {
                "darwin": "osx",
                "linux": "linux",
                "win": "windows",
            }[os],
            "@platforms//cpu:" + {
                "arm64": "aarch64",
                "x64": "x86_64",
            }[arch],
        ],
    )
    for platform, (os, arch) in NODE_PLATFORMS.items()
]

NODE_DISTRIBUTIONS = [
    (
        "node" + major + "_" + platform + variant,
        platform,
        "@node" + major + "_" + (("linux_musl" if variant else "linux_glibc") if os == "linux" else os) + "_" + arch,
        "runner/externals/node" + major + variant,
    )
    for platform, (os, arch) in NODE_PLATFORMS.items()
    for major in [
        "20",
        "24",
    ]
    for variant in ([
        "",
        "_alpine",
    ] if os == "linux" else [""])
]

[
    [
        select_file(
            name = "externals_files_" + target + "_license",
            srcs = repo + "//:npm_files",
            subpath = "bin/nodejs/LICENSE",
        ),
        pkg_files(
            name = "externals_files_" + target,
            srcs = [
                repo + "//:node_bin",
                ":externals_files_" + target + "_license",
            ],
            prefix = prefix,
            strip_prefix = strip_prefix.from_root("bin/nodejs"),
            renames = {repo + "//:node_bin": "bin/node.exe"} if platform.startswith("win_") else {},
            attributes = pkg_attributes(mode = "0755"),
        ),
    ]
    for target, platform, repo, prefix in NODE_DISTRIBUTIONS
]

pkg_filegroup(
    name = "externals_files",
    srcs = select({
        ":externals_files_" + platform: [
            ":externals_files_" + target
            for target, target_platform, _, _ in NODE_DISTRIBUTIONS
            if target_platform == platform
        ]
        for platform in NODE_PLATFORMS
    }),
    visibility = ["//visibility:public"],
)

RID = select({
    "@platforms//os:linux": "linux",
    "@platforms//os:osx": "osx",
    "@platforms//os:windows": "win",
}) + "-" + select({
    "@platforms//cpu:aarch64": "arm64",
    "@platforms//cpu:x86_64": "x64",
})

config_setting(
    name = "bundled_dotnet",
    flag_values = {"//:bundled-dotnet": "true"},
)

msbuild_publish(
    name = "worker",
    srcs = ["@actions_runner//:msbuild_sources"],
    packages = ["@msbuild_feed//:packages"],
    project = "Runner.Worker/Runner.Worker.csproj",
    assembly_name = "Runner.Worker",
    binary_name = "hrc-worker",
    staged_files = {"@actions_runner//:build_constants": "Runner.Sdk/BuildConstants.cs"},
    properties = select({
        ":externals_files_" + platform: {
            "BUILD_OS": {
                "darwin": "OSX",
                "linux": "Linux",
                "win": "Windows",
            }[os],
            "PackageRuntime": {
                "darwin": "osx",
                "linux": "linux",
                "win": "win",
            }[os] + "-" + arch,
        }
        for platform, (os, arch) in NODE_PLATFORMS.items()
    }),
    version = "@actions_runner//:runnerversion",
    rid = RID,
    self_contained = select({
        ":bundled_dotnet": True,
        "//conditions:default": False,
    }),
    visibility = ["//visibility:public"],
)

py_test(
    name = "runtime_config_test",
    size = "small",
    srcs = ["runtime_config_test.py"],
    args = ["$(rootpath :worker)"],
    data = [":worker"],
    visibility = ["//visibility:public"],
)

pkg_files(
    name = "worker_files",
    srcs = [":worker"],
    strip_prefix = strip_prefix.files_only(),
    renames = select({
        "@platforms//os:windows": {":worker": "hrc-worker.exe"},
        "//conditions:default": {":worker": "hrc-worker"},
    }),
    attributes = pkg_attributes(mode = "0755"),
)

pkg_files(
    name = "worker_scripts",
    srcs = [
        "@actions_runner//:Misc/layoutbin/hashFiles/index.js",
        "@actions_runner//:Misc/layoutbin/macos-run-invoker.js",
    ],
    prefix = "runner/scripts",
    strip_prefix = strip_prefix.files_only(),
    renames = {
        "@actions_runner//:Misc/layoutbin/hashFiles/index.js": "hashFiles.js",
        "@actions_runner//:Misc/layoutbin/macos-run-invoker.js": "macosRunInvoker.js",
    },
)

pkg_files(
    name = "worker_metadata",
    srcs = [
        "@actions_runner//:runnerversion",
        "@actions_runner_license//file",
    ],
    prefix = "runner",
    strip_prefix = strip_prefix.files_only(),
    renames = {"@actions_runner//:runnerversion": "VERSION"},
)

pkg_filegroup(
    name = "runner",
    srcs = [
        ":externals_files",
        ":worker_files",
        ":worker_metadata",
        ":worker_scripts",
    ],
    visibility = ["//visibility:public"],
)
