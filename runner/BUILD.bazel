load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools:platforms.bzl", "ARCH", "OS")
load(":runner.bzl", "node_externals", "runner_layout")

exports_files([
    "build.py",
    "runner.BUILD.bazel",
])

filegroup(
    name = "starlark_sources",
    srcs = [
        "BUILD.bazel",
        "runner.BUILD.bazel",
        "runner.bzl",
    ],
    visibility = ["//visibility:public"],
)

runner_layout(
    name = "runner",
    srcs = ["@actions_runner//:sources"],
    dev = "@actions_runner//:src/dev.sh",
    os = OS,
    arch = ARCH,
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

node_externals(name = "externals_files")

pkg_tar(
    name = "externals",
    srcs = [":externals_files"],
    extension = "tar.gz",
    mode = "",
    stamp = 0,
    visibility = ["//visibility:public"],
)
