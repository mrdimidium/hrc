load("//tools:platforms.bzl", "RID")
load(":runner.bzl", "runner_layout")

exports_files([
    "build.py",
    "runner.BUILD.bazel",
])

filegroup(
    name = "starlark_sources",
    srcs = [
        "BUILD.bazel",
        "runner.BUILD.bazel",
        "runner.bzl",
    ],
    visibility = ["//visibility:public"],
)

runner_layout(
    name = "runner",
    srcs = ["@actions_runner//:sources"],
    dev = "@actions_runner//:src/dev.sh",
    rid = RID,
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
