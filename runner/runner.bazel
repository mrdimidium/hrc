exports_files(["LICENSE"] + glob(["src/**"]))

[
    filegroup(
        name = project + "_sources",
        srcs = glob(
            ["src/" + project + "/**/*.cs"],
            exclude = [
                "src/**/bin/**",
                "src/**/obj/**",
                "src/Runner.Sdk/BuildConstants.cs",
            ],
        ),
        visibility = ["//visibility:public"],
    )
    for project in [
        "Sdk",
        "Runner.Sdk",
        "Runner.Common",
        "Runner.Worker",
    ]
]
