.{
    // Stable identity of this host.
    .id = "build-01",
    // Paths are relative to the service working directory on each OS.
    // Versioned runner installations, retained across upgrades.
    .bindir = "bin",
    // Per-job workspaces, currently owned by the controller account.
    .rundir = "jobs",
    .groups = .{
        .{
            .github = .{
                .url = "https://github.com/example-org",
                .name = "github-builds",
                .labels = .{ "linux", "X64" },
                .runner_group_id = 1,
                // Read a PAT with permission to manage runners from the environment.
                .token = .{ .env = "GITHUB_TOKEN" },
            },
        },
    },
}
