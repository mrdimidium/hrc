#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034
# SPDX-FileCopyrightText: 2026 Nikolay Govorov
# SPDX-License-Identifier: BSD-3-Clause

description="Hosted Runner Controller"

command="/usr/local/bin/hrc"
command_args="-config /etc/hrc/hrc.json"
command_user="hrc:hrc"
directory="/var/lib/hrc"
required_files="/etc/hrc/hrc.json"

supervisor="supervise-daemon"
respawn_delay=10
respawn_max=0
retry="TERM/60/KILL/5"
stopgroup="yes"
umask="0077"
output_log="/var/log/hrc/stdout.log"
error_log="/var/log/hrc/stderr.log"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath -d -o hrc:hrc -m 0700 /var/lib/hrc || return 1
    checkpath -d -o hrc:hrc -m 0700 /var/log/hrc || return 1
}
