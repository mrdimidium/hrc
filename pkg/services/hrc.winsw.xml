<service>
  <id>hrc</id>
  <name>hrc</name>
  <description>Controller for ephemeral GitHub and Forgejo runners</description>
  <!-- control.ps1 fills these paths for the selected installation directories. -->
  <executable>hrc.exe</executable>
  <arguments>-config hrc.zon</arguments>
  <workingdirectory>.</workingdirectory>
  <logpath>logs</logpath>
  <log mode="roll" />
  <startmode>Manual</startmode>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
  </serviceaccount>
  <onfailure action="restart" delay="10 sec" />
  <stoptimeout>60 sec</stoptimeout>
</service>
