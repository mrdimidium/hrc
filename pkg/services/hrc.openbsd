#!/bin/ksh
# SPDX-FileCopyrightText: 2026 Nikolay Govorov
# SPDX-License-Identifier: BSD-3-Clause

# rc.subr consumes the service variables below.
# shellcheck disable=SC2034

# Install as /etc/rc.d/hrc. A login class in /etc/login.conf.d/hrc can
# provide host-specific tool paths and resource limits for builds.
daemon="/usr/local/bin/hrc"
daemon_flags="-config /etc/hrc/hrc.zon"
daemon_user="hrc"
daemon_execdir="/var/db/hrc"
daemon_logger="daemon.info"
daemon_timeout=60

# shellcheck disable=SC1091
. /etc/rc.d/rc.subr

rc_bg=YES
rc_reload=NO

rc_pre() {
    test -r /etc/hrc/hrc.zon
}

rc_start() {
    rc_exec "umask 0077; exec ${daemon} ${daemon_flags}"
}

rc_cmd "$1"
