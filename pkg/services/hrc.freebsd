#!/bin/sh
# SPDX-FileCopyrightText: 2026 Nikolay Govorov
# SPDX-License-Identifier: BSD-3-Clause

# rc.subr consumes the service variables below.
# shellcheck disable=SC2034

# PROVIDE: hrc
# REQUIRE: LOGIN FILESYSTEMS DAEMON NETWORKING
# KEYWORD: shutdown

# shellcheck disable=SC1091
. /etc/rc.subr

name="hrc"

rcvar="hrc_enable"
load_rc_config "$name"

: "${hrc_enable:=NO}"

pidfile="/var/run/hrc.pid"
hrc_chdir="/var/db/hrc"
required_files="/usr/local/etc/hrc/hrc.zon"

command="/usr/sbin/daemon"
command_args="-R 10 -P $pidfile -u hrc -S -T hrc /usr/local/bin/hrc -config /usr/local/etc/hrc/hrc.zon"
run_rc_command "$1"
