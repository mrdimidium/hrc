#!/bin/sh
# SPDX-FileCopyrightText: 2026 Nikolay Govorov
# SPDX-License-Identifier: BSD-3-Clause

# rc.subr consumes the service variables below.
# shellcheck disable=SC2034

# Install as /etc/rc.d/hrc. Requires the sysutils/daemonize pkgsrc package.
# PROVIDE: hrc
# REQUIRE: DISKS DAEMON NETWORKING
# BEFORE: LOGIN
# KEYWORD: shutdown

# shellcheck disable=SC1091
. /etc/rc.subr

name="hrc"
rcvar="hrc"
procname="/usr/pkg/bin/hrc"
pidfile="/var/run/hrc.pid"
required_files="/usr/pkg/etc/hrc/hrc.zon /usr/pkg/bin/hrc"

# Keep pkgsrc tools available to runners; /etc/rc.conf.d/hrc may override this.
hrc_env="PATH=/usr/pkg/bin:/usr/pkg/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
load_rc_config "$name"
: "${hrc:=NO}"

command="/usr/pkg/sbin/daemonize"
command_args="-a -c /var/db/hrc -u hrc -p $pidfile -o /var/log/hrc/stdout.log -e /var/log/hrc/stderr.log /usr/pkg/bin/hrc -config /usr/pkg/etc/hrc/hrc.zon"

umask 0077
run_rc_command "$1"
